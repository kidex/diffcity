          "kind": "ctx",
          "text": "  async create(req: Req, res: Res) {"
        },
        {
          "kind": "ctx",
          "text": "    const dto = CreateOrderDto.from(req.body);"
        },
        {
          "kind": "ctx",
          "text": "    const order = await this.svc.place(req.user, dto);"
        },
        {
          "kind": "del",
          "text": "    res.status(201).json(order);"
        },
        {
          "kind": "add",
          "text": "    res.status(201).json({ order, discounted: dto.discountPct > 0 });"
        },
        {
          "kind": "ctx",
