    {
      "order": 3,
      "symbolId": "src/services/orders/orders.service.ts#OrdersService.place",
      "fileId": "src/services/orders/orders.service.ts",
      "why": "Body changed",
      "diff": [
        {
          "kind": "ctx",
          "text": "  async place(user: { id: string }, dto: CreateOrderDto) {"
        },
        {
          "kind": "ctx",
          "text": "    this.validate(dto);"
        },
        {
          "kind": "del",
          "text": "    const total = dto.items.reduce((sum, item) => sum.plus(Money.of(item.length)), Money.zero());"
        },
        {
          "kind": "del",
          "text": "    return this.repo.insert({ ownerId: user.id, total });"
        },
        {
          "kind": "add",
          "text": "    const total = this.calcTotal(dto);"
        },
        {
          "kind": "add",
          "text": "    const discounted = this.applyDiscount(total, dto.rules);"
        },
        {
          "kind": "add",
          "text": "    const order = await this.repo.insert({ ownerId: user.id, total, discounted, discountPct: dto.discountPct });"
        },
        {
          "kind": "add",
          "text": "    await this.notify(user.id);"
        },
        {
          "kind": "add",
          "text": "    return order;"
        },
        {
          "kind": "ctx",
          "text": "  }"
        }
      ],
