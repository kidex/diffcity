{
  "name": "diffcity",
  "version": "0.1.0",
  "description": "Local visual code review for code written by AI agents: every change becomes a 3D city with review verdicts.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidex/diffcity.git"
  },
  "bin": {
    "diffcity": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build:node": "node scripts/clean-dist.mjs --node && tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build": "npm run build:node && npm run build:ui",
    "dev:ui": "vite",
    "design:directions": "vite --config design/directions/vite.config.ts --host 127.0.0.1 --port 4400",
    "design:directions:build": "vite build --config design/directions/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui && tsc --noEmit -p test/unit/ui",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test -c test/playwright.config.ts",
    "prepare": "node scripts/copy-grammars.mjs",
    "proof": "node scripts/proof.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "fastify": "5.12.5",
    "ts-morph": "28.0.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "three": "0.186.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
