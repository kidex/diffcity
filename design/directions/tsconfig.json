{
  // The visual-direction pages run in the browser like src/ui (DOM lib, Vite
  // client types); vite.config.ts needs the Node types. A design reference
  // outside the project gates: `npm run typecheck` does not include it; Vite
  // builds the pages, tsc never emits them.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": []
}
