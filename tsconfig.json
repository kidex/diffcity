{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "vite.config.ts", "vite.standalone.config.ts", "scripts/*.d.mts"],
  // src/ui and its unit tests run in the browser: they have their own
  // tsconfig with the DOM lib (ADR-022), checked by `npm run typecheck`.
  "exclude": ["test/fixtures", "src/ui", "test/unit/ui"]
}
